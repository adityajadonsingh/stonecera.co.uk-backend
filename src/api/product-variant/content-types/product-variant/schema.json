{
  "kind": "collectionType",
  "collectionName": "product_variants",
  "info": {
    "singularName": "product-variant",
    "pluralName": "product-variants",
    "displayName": "Product Variant"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "sku": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "product_variants"
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "inversedBy": "product_variants"
    },
    "discount": {
      "type": "integer",
      "default": 0
    },
    "size": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::size.size",
      "inversedBy": "product_variants"
    },
    "thickness": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::thickness.thickness",
      "inversedBy": "product_variants"
    },
    "finish": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::finish.finish",
      "inversedBy": "product_variants"
    },
    "color": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::color.color",
      "inversedBy": "product_variants"
    },
    "labels": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::label.label",
      "mappedBy": "product_variants"
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "stock": {
      "type": "integer",
      "required": true
    },
    "packSize": {
      "type": "decimal",
      "required": true
    },
    "pieces": {
      "type": "integer",
      "required": true
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "isDefault": {
      "type": "boolean",
      "required": false,
      "default": false
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "seo": {
      "type": "component",
      "component": "seo.meta",
      "repeatable": false
    }
  }
}
